<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 扩展隐式 using（WPF 默认不含 System.IO） -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Net.Http.Headers" />
    <Using Include="System.Net.Http.Json" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.ComponentModel" />
    <Using Include="System.Text.RegularExpressions" />
    <Using Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- 排除 assets 中的 .cs 文件（已整合到 Core/） -->
  <ItemGroup>
    <Compile Remove="assets\**\*.cs" />
    <None Remove="assets\**\*.cs" />
  </ItemGroup>

  <!-- 素材文件复制到输出目录 -->
  <ItemGroup>
    <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\" />
    <None Update="lawnicons_assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="lawnicons_assets\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <!-- ============================================================
       Release 发布配置
       使用: dotnet publish -c Release
       说明: 自包含、仅中文语言、排除lawnicons素材（运行时自下载）
       ============================================================ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- 自包含=true ~149MB || false ~8MB（需用户装.NET 8 Runtime） -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- ReadyToRun 会增加 ~20MB（双份 IL+原生），关闭以减小体积 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>$(MSBuildThisFileDirectory)publish\</PublishDir>
    <!-- 只保留中文语言包 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 移除调试支持和未使用功能 -->
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- 发布时排除 lawnicons_assets（运行时自动下载），砍掉 ~40MB -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="lawnicons_assets\**\*" />
    <None Remove="lawnicons_assets\**\*" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 扩展隐式 using（WPF 默认不含 System.IO） -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Net.Http.Headers" />
    <Using Include="System.Net.Http.Json" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.ComponentModel" />
    <Using Include="System.Text.RegularExpressions" />
    <Using Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- 排除 assets 中的 .cs 文件（已整合到 Core/） -->
  <ItemGroup>
    <Compile Remove="assets\**\*.cs" />
    <None Remove="assets\**\*.cs" />
  </ItemGroup>

  <!-- 素材文件复制到输出目录 -->
  <ItemGroup>
    <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\" />
    <None Update="lawnicons_assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="lawnicons_assets\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <!-- ============================================================
       Release 发布配置
       使用: dotnet publish -c Release
       说明: 自包含、ReadyToRun、输出为文件夹（打 ZIP 分发）
       ============================================================ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- 自包含：用户无需安装 .NET 运行时 -->
    <SelfContained>true</SelfContained>
    <!-- 目标系统 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- ReadyToRun：预编译 IL，启动更快 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 不使用单文件模式，保持 assets/ 目录可访问 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 裁剪未使用的程序集（保守模式，避免误删 WPF 依赖） -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 生成单个压缩包 -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- 输出到 publish/ 目录 -->
    <PublishDir>$(MSBuildThisFileDirectory)publish\</PublishDir>
  </PropertyGroup>

</Project>

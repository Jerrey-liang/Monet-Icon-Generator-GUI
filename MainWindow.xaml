<Window x:Class="MonetIconGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperOS 桌面莫奈图标生成器"
        Width="920" Height="680"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 主按钮：填充色 -->
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 标题栏 ========== -->
        <Border Grid.Row="0" Background="#1E1E2E" Padding="0">
            <Grid>
                <!-- 左侧品牌区 -->
                <StackPanel Orientation="Horizontal" Margin="18,14,0,12">
                    <!-- 小色块装饰 -->
                    <Border Width="4" CornerRadius="2" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="HyperOS Monet"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="#F1F5F9"/>
                        <TextBlock Text="桌面莫奈图标生成器"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧版本号 -->
                <TextBlock Text="v1.0"
                           FontSize="11" Foreground="#64748B"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,18,0"/>
            </Grid>
        </Border>

        <!-- ========== 主体内容 ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,8">

                <!-- 第一节：取色 -->
                <GroupBox Padding="14" Margin="0,0,0,14">
                    <GroupBox.Header>
                        <TextBlock Text="获取颜色" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="#334155"/>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="通过 ADB 获取手机当前 Monet 颜色配置"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="#475569"/>
                            <TextBlock Text="请确认手机已连接并允许 USB 调试"
                                       Foreground="#94A3B8" Margin="0,0,0,12"/>
                            <Button x:Name="BtnFetchColors" Content="获取颜色配置"
                                    Width="150" Height="34"
                                    Click="BtnFetchColors_Click"
                                    IsDefault="True"
                                    Style="{StaticResource Button}"/>
                            <TextBlock x:Name="TxtColorStatus" Margin="0,10,0,0"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>

                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Margin="18,0,0,0" MaxHeight="140"
                                Background="#F8FAFC">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="颜色预览"
                                           FontSize="12" Foreground="#64748B"
                                           Margin="10,7,10,4"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ColorPreviewList" Margin="8,0"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- 第二节：生成图标 -->
                <GroupBox Padding="14" Margin="0,0,0,14">
                    <GroupBox.Header>
                        <TextBlock Text="生成图标" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="#334155"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="图标风格" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Foreground="#475569"/>
                            <RadioButton x:Name="RbRect" Content="圆角矩形"
                                         IsChecked="True" GroupName="IconStyle"
                                         Margin="0,0,18,0"/>
                            <RadioButton x:Name="RbRound" Content="圆形"
                                         GroupName="IconStyle"/>
                        </StackPanel>

                        <CheckBox x:Name="CbDarkMode"
                                  Content="启用自动切换深色模式（增大文件体积）"
                                  Margin="0,0,0,6" Foreground="#475569"/>
                        <StackPanel x:Name="PanelLightMode"
                                    Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="单色模式" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Foreground="#475569"/>
                            <RadioButton x:Name="RbLightIcon" Content="浅色图标包"
                                         GroupName="LightMode" IsChecked="True"
                                         Margin="0,0,14,0"/>
                            <RadioButton x:Name="RbDarkIcon" Content="深色图标包"
                                         GroupName="LightMode"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnProcess" Content="开始生成"
                                    Width="130" Height="34"
                                    Click="BtnProcess_Click"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Button}"/>
                            <ProgressBar Grid.Column="1" x:Name="PbProcess"
                                         Height="18" Margin="18,0,0,0"
                                         VerticalAlignment="Center"
                                         Minimum="0" Maximum="100"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       x:Name="TxtProcessStatus"
                                       Margin="18,4,0,0" FontSize="12"
                                       TextWrapping="Wrap" Foreground="#475569"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 第三节：刷入包 -->
                <GroupBox Padding="14">
                    <GroupBox.Header>
                        <TextBlock Text="生成刷入包" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="#334155"/>
                    </GroupBox.Header>
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Button x:Name="BtnPackageMagisk"
                                    Content="打包 Magisk 模块"
                                    Width="150" Height="34"
                                    Click="BtnPackageMagisk_Click"
                                    Style="{StaticResource Button}"
                                    Margin="0,0,10,6"/>
                            <Button x:Name="BtnPackageMtz"
                                    Content="打包 MTZ 主题"
                                    Width="140" Height="34"
                                    Click="BtnPackageMtz_Click"
                                    Style="{StaticResource Button}"
                                    Margin="0,0,0,6"/>
                        </WrapPanel>

                        <TextBlock x:Name="TxtPackageStatus"
                                   TextWrapping="Wrap" FontSize="12" Foreground="#475569"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== 底部状态栏 ========== -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="就绪"
                           FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
                <TextBlock Text="by Jerrey_liang"
                           FontSize="11" Foreground="#CBD5E1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
